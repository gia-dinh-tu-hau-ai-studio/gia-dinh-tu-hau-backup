{
  "name": "gia-dinh-tu-hau",
  "version": "1.0.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/verify-sites-build.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop": "electron .",
    "desktop:build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.2",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "productName": "Gia Đình Tư Hậu",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.giadinhtuhau.desktop",
    "productName": "Gia Đình Tư Hậu",
    "artifactName": "Gia-Dinh-Tu-Hau-Setup-${version}.${ext}",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "electron/**/*",
      "public/logo.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "shortcutName": "Gia Đình Tư Hậu",
      "createDesktopShortcut": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
